{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OneFeed plugin manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "minHostVersion",
    "capabilities",
    "kinds",
    "feeds"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "minHostVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "entry": {
      "type": "string",
      "pattern": "^[^/\\\\]+$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "http",
          "cli",
          "browser"
        ]
      }
    },
    "cli": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "video",
          "images",
          "article",
          "short",
          "list"
        ]
      }
    },
    "feeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "requiresAuth": {
            "type": "boolean"
          },
          "personalized": {
            "type": "boolean"
          }
        }
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key"
        ]
      }
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "themeColor": {
      "type": "string"
    }
  }
}
