{
  "schemaVersion": 1,
  "id": "bilibili",
  "name": "哔哩哔哩",
  "version": "0.5.1",
  "author": "onefeed-plugins",
  "description": "B 站首页推荐与关注动态（只读，经本机 bili CLI）；详情页可出 AI 总结",
  "license": "MIT",
  "homepage": "https://github.com/publieople/onefeed-plugins",
  "minHostVersion": "0.2.0",
  "entry": "index.js",
  "themeColor": "#FB7299",
  "capabilities": [
    "cli"
  ],
  "cli": {
    "allow": [
      [
        "bili",
        "feed"
      ],
      [
        "bili",
        "video"
      ],
      [
        "bili",
        "comment"
      ]
    ],
    "env": {
      "BILI_CLI_HOME": "${state}/toolhome/bili-cli"
    },
    "seed": [
      {
        "from": "${appdata}/bili-cli/credential.json",
        "to": "${state}/toolhome/bili-cli/credential.json"
      }
    ]
  },
  "kinds": [
    "video",
    "short",
    "images"
  ],
  "features": [
    "comments",
    "detail",
    "media",
    "summary"
  ],
  "feeds": [
    {
      "id": "recommend",
      "name": "首页推荐",
      "requiresAuth": true,
      "personalized": true
    },
    {
      "id": "timeline",
      "name": "关注动态",
      "requiresAuth": true,
      "personalized": true
    },
    {
      "id": "following",
      "name": "关注",
      "requiresAuth": true,
      "personalized": true
    }
  ],
  "embeds": [
    "bilibili"
  ],
  "mediaHosts": [
    "*.hdslb.com",
    "*.bilibili.com"
  ]
}
